# Copy to .env (never committed) to override the local defaults of
# docker-compose.yml. Required on a server: set strong, unique passwords,
# e.g. generated with `openssl rand -hex 24`.

POSTGRES_DB=incidents
POSTGRES_USER=incidents
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

# Submissions allowed per IP address and per minute.
RATE_LIMIT_PER_MINUTE=5

# Where the app is published on the host.
# Local: 127.0.0.1 (this machine only). Server: 0.0.0.0 and port 80.
APP_BIND=127.0.0.1
APP_PORT=8000
